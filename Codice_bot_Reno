def kp_to_storm_level(kp):
    """Converte indice Kp in livello di tempesta geomagnetica"""
    if kp < 5:
        return "—"
    elif kp < 6:
        return "G1"
    elif kp < 7:
        return "G2"
    elif kp < 8:
        return "G3"
    elif kp < 9:
        return "G4"
    else:
        return "G5"

def aurora(update, context):
    try:
        response = requests.get(API_AURORA, timeout=10)
        response.raise_for_status()
        data = response.json()

        # Il primo elemento è l'intestazione
        values = data[1:]

        # Ultimo dato disponibile
        ultimo_tempo, ultimo_kp = values[-1][0], float(values[-1][1])
        scala = kp_to_storm_level(ultimo_kp)

        messaggio = (
            "🌌 *Indice Kp geomagnetico NOAA*\n"
            "--------------------------------\n"
            f"🕒 Ultimo dato: {ultimo_tempo} UTC\n"
            f"📈 Kp attuale: {ultimo_kp:.2f}\n"
            f"🌍 Scala NOAA: {scala}\n\n"
            "📅 *Previsione prossimi 3 giorni:*\n"
        )

        # Mostra previsioni future (esclude l'ultimo dato, che è "attuale")
        from datetime import datetime, timedelta

        now = datetime.utcnow()
        future_data = [
            (datetime.strptime(entry[0], "%Y-%m-%d %H:%M:%S"), float(entry[1]))
            for entry in values
        ]
        # Filtra solo dati dopo "adesso" e nei prossimi 3 giorni
        fine = now + timedelta(days=3)
        future_data = [x for x in future_data if now < x[0] <= fine]

        for dt, kp in future_data:
            messaggio += f"• {dt.strftime('%Y-%m-%d %H:%M:%S')} → Kp {kp:.2f} ({kp_to_storm_level(kp)})\n"

        update.message.reply_text(messaggio, parse_mode="Markdown")

    except Exception as e:
        print("Errore aurora:", e)
        update.message.reply_text("❌ Errore nel recupero dei dati NOAA.")

